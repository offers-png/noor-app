# Local development only. Never prefix provider secrets with VITE_.
ELEVENLABS_API_KEY=
YOUTUBE_API_KEY=

# Optional: choose voices available to your ElevenLabs account.
# ELEVENLABS_TEACHER_VOICE_ID=
# ELEVENLABS_STORY_VOICE_ID=

# Optional: restrict discovery and playback to reviewed channel IDs, comma-separated.
# YOUTUBE_ALLOWED_CHANNEL_IDS=

# Public frontend setting for an alternative lesson/profile backend.
# VITE_API_URL=http://localhost:8000
