# Public URL of your deployed content proxy. Contains no credentials.
# EAS preview/production builds default to the hosted Netlify proxy in eas.json.
EXPO_PUBLIC_CONTENT_PROXY_URL=https://issa-uzair.netlify.app/content
EXPO_PUBLIC_QF_ENV=production
# QF_CLIENT_ID, QF_CLIENT_SECRET, and SUNNAH_API_KEY belong in server/.env only.
